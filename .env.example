# ==========================================
# CareerOS Environment Configuration Template
# ==========================================

# Core Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
SECRET_KEY=careeros-super-secure-jwt-secret-key-change-in-prod-2026

# Supabase / Database Configuration
# Default local mode uses SQLite at sqlite+aiosqlite:///./careeros.db
# When connecting to Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./careeros.db
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=resumes

# AI & LLM Provider Configuration
# Supported: Google Gemini API (gemini-1.5-flash / gemini-2.0-flash / gemini-1.5-pro)
GEMINI_API_KEY=
AI_MODEL_FAST=gemini-2.0-flash
AI_MODEL_REASONING=gemini-1.5-pro
AI_MODEL_EMBEDDING=text-embedding-004

# GitHub OAuth / API Integration
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback

# Public Profile & Domain Configuration
PUBLIC_PROFILE_BASE_URL=http://localhost:3000
CUSTOM_DOMAIN=

# Optional Email & Calendar Integration (Google Workspace / Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Browser Automation & Playwright Settings
PLAYWRIGHT_HEADLESS=true
BROWSER_AUTOMATION_ENABLED=true
BROWSER_TIMEOUT_MS=30000

# Observability & Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
